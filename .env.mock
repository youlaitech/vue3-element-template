# 独立 mock 服务构建环境（pnpm build:mock → .deploy/mock-server）
#
# VITE_BASE_URL：部署基础路径，必须与 nginx 里的访问路径一致（这里部署在 /template/ 下）
VITE_BASE_URL=/template/

# VITE_API_BASE：同时决定三件事，必须一致，否则 mock 不会被命中：
#   1. 前端请求前缀（src/utils/request.ts 的 baseURL、src/utils/sse.ts）
#   2. mock 文件的 URL 前缀（mock/base.ts 拼出的完整路径）
#   3. mock 服务的拦截前缀（插件读取 server.proxy 的 key，路径不以它开头直接放行）
# 用 /mock-api 而不是 /prod-api：admin.youlai.tech 的 /prod-api/ 已指向真实后端 :8000，
# 且首页/瘦身版/naiveui 三个站点共用它，改不得。nginx 里对应加：
#   location ^~ /mock-api/ { proxy_pass http://127.0.0.1:8081; }   # 末尾不加 /
VITE_API_BASE=/mock-api

# 应用端口（构建期不需要，仅保持与其它 env 一致；仅 Vite 读取）
APP_PORT=3000

# 项目名称
VITE_APP_TITLE=vue3-element-template

# 接口地址（仅开发代理转发用，构建独立 mock 服务时不生效）
API_PROXY_TARGET=http://localhost:8000

# 开启 mock 插件
VITE_MOCK_ENABLED=true

# 产出独立 mock 服务：产物在 .deploy/mock-server
VITE_MOCK_BUILD=true

# 独立 mock 服务监听端口
VITE_MOCK_PORT=8081
